<%# 記事の詳細画面 %>

<p style="color: green"><%= notice %></p>

<%= render @post %>

<%# 画像が添付されている場合は表示 %>
<% if @post.image.attached? %>
  <div>
    <%= image_tag @post.image %>
  </div>
<% end %>

<div>
  <%= link_to "この投稿を編集する", edit_post_path(@post) %> |
  <%= link_to "投稿一覧へ戻る", posts_path %>

  <%= button_to "この投稿を削除する", @post, method: :delete %>
</div>
